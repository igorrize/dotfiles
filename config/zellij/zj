#!/bin/bash

# Zellij launcher — named session, attach-or-create.
# Usage: zj [layout]   (default layout: dev; the session is named after the layout)
# Reattaches to an existing session of that name (survives disconnect on a remote box),
# otherwise creates it with the matching layout.
layout="${1:-dev}"

zellij attach "$layout" 2>/dev/null \
  || zellij --session "$layout" --layout ~/.config/zellij/layouts/"${layout}.kdl"
